# Copy to .env (never commit .env). Values come from https://www.linkedin.com/developers/apps -> your app -> Auth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URL" in your LinkedIn app
LINKEDIN_REDIRECT_URI=http://localhost:3000/auth/linkedin/callback
PORT=3000
# Set to production when deployed (hides developer logs)
NODE_ENV=development
# Optional: LinkedIn API version header (YYYYMM). Update if LinkedIn sunsets this one.
LINKEDIN_API_VERSION=202608
